pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        AWS_REGION = 'us-east-1'
        TF_STATE_BUCKET = credentials('terraform-state-bucket')
        WORKLOAD_DIR = 'terraform/environments/prod/workloads'
    }

    stages {
        stage('Checkout and validate tools') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    command -v aws
                    command -v docker
                    command -v terraform
                    command -v kubectl
                    terraform -chdir="$WORKLOAD_DIR" fmt -check
                '''
            }
        }

        stage('Build and push NGINX image') {
            steps {
                script {
                    env.IMAGE_TAG = "nginx-${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                }
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-production-deployer'
                ]]) {
                    sh '''
                        set -eu
                        set +x
                        terraform -chdir=terraform/environments/prod/infra init \
                          -backend-config="bucket=$TF_STATE_BUCKET" \
                          -backend-config="key=production-v2/infra/terraform.tfstate" \
                          -backend-config="region=$AWS_REGION" \
                          -backend-config="use_lockfile=true"
                        ECR_URI=$(terraform -chdir=terraform/environments/prod/infra output -raw ecr_repository_url)
                        ECR_REGISTRY="${ECR_URI%%/*}"
                        aws ecr get-login-password --region "$AWS_REGION" |
                          docker login --username AWS --password-stdin "$ECR_REGISTRY"
                        docker build -t "$ECR_URI:$IMAGE_TAG" app
                        docker push "$ECR_URI:$IMAGE_TAG"
                        docker logout "$ECR_REGISTRY" >/dev/null 2>&1 || true
                    '''
                }
            }
        }

        stage('Terraform plan') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-production-deployer'
                ]]) {
                    sh '''
                        set -eu
                        terraform -chdir="$WORKLOAD_DIR" init \
                          -backend-config="bucket=$TF_STATE_BUCKET" \
                          -backend-config="key=production-v2/workloads/terraform.tfstate" \
                          -backend-config="region=$AWS_REGION" \
                          -backend-config="use_lockfile=true"
                        terraform -chdir="$WORKLOAD_DIR" validate
                        terraform -chdir="$WORKLOAD_DIR" plan \
                          -var="state_bucket=$TF_STATE_BUCKET" \
                          -var="image_tag=$IMAGE_TAG" \
                          -out=production.tfplan
                    '''
                }
            }
        }

        stage('Approve production deployment') {
            steps {
                input message: "Deploy ${env.IMAGE_TAG} to the production EKS namespace?", ok: 'Deploy'
            }
        }

        stage('Apply Terraform workloads') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-production-deployer'
                ]]) {
                    sh '''
                        set -eu
                        terraform -chdir="$WORKLOAD_DIR" apply production.tfplan
                        kubectl rollout status deployment/nginx -n production --timeout=5m
                        terraform -chdir="$WORKLOAD_DIR" plan \
                          -var="state_bucket=$TF_STATE_BUCKET" \
                          -var="image_tag=$IMAGE_TAG" \
                          -var='enable_network_policy=true' \
                          -out=network-policy.tfplan
                        terraform -chdir="$WORKLOAD_DIR" apply network-policy.tfplan
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                rm -f "$WORKLOAD_DIR/production.tfplan" \
                      "$WORKLOAD_DIR/network-policy.tfplan"
            '''
        }
    }
}
