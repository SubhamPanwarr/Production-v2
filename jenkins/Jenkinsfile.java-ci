pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        CI_IMAGE = "java-login-app:ci-${BUILD_NUMBER}"
        DB_URL = 'jdbc:mysql://127.0.0.1:3306/UserDB'
        DB_USERNAME = 'ci_placeholder'
        DB_PASSWORD = 'ci_placeholder_only'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'rm -f trivy-report.txt ecr-image.txt'
                sh 'git log -1 --oneline'
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                    docker version
                    trivy --version
                    aws --version
                    kubectl version --client
                '''
            }
        }

        // Fail early if the Jenkins deployment role or namespace RBAC is missing.
        // Only read-only Kubernetes commands are used here.
        stage('EKS CD Preflight') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-publisher',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        unset AWS_SESSION_TOKEN
                        export AWS_DEFAULT_REGION=us-east-1 AWS_PAGER=""

                        ROLE_ARN="arn:aws:iam::523881172609:role/production-v3-jenkins-deploy-role"
                        ASSUMED="$(aws sts assume-role \
                            --role-arn "$ROLE_ARN" \
                            --role-session-name "jenkins-v3-check-${BUILD_NUMBER}" \
                            --duration-seconds 900 \
                            --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
                            --output text)"
                        set -- $ASSUMED
                        if [ "$#" -ne 3 ]; then
                            echo 'ERROR: Could not parse STS temporary credentials'
                            exit 1
                        fi
                        export AWS_ACCESS_KEY_ID="$1"
                        export AWS_SECRET_ACCESS_KEY="$2"
                        export AWS_SESSION_TOKEN="$3"
                        unset ASSUMED

                        KUBECONFIG="$(mktemp)"
                        export KUBECONFIG
                        trap 'rm -f "$KUBECONFIG"' EXIT
                        chmod 600 "$KUBECONFIG"

                        echo '=== Assumed Jenkins CD role ==='
                        aws sts get-caller-identity --query Arn --output text
                        echo '=== EKS cluster ==='
                        aws eks describe-cluster \
                            --name production-v3-eks \
                            --region us-east-1 \
                            --query 'cluster.status' \
                            --output text
                        aws eks update-kubeconfig \
                            --name production-v3-eks \
                            --region us-east-1 \
                            --kubeconfig "$KUBECONFIG" >/dev/null

                        echo '=== Namespace permissions ==='
                        kubectl auth can-i get deployment/java-login-app -n production-v3 | grep -qx yes
                        kubectl auth can-i patch deployment/java-login-app -n production-v3 | grep -qx yes
                        kubectl auth can-i watch deployment/java-login-app -n production-v3 | grep -qx yes
                        kubectl auth can-i list replicasets -n production-v3 | grep -qx yes

                        kubectl get deployment java-login-app -n production-v3
                        echo 'EKS CD preflight passed.'
                    '''
                }
            }
        }

        stage('Maven Build and Test') {
            steps {
                dir('application/java-login-app') {
                    sh 'mvn -B -ntp clean verify'
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                dir('application/java-login-app') {
                    withCredentials([
                        string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN')
                    ]) {
                        sh '''
                            set -eu
                            set +x
                            mvn -B -ntp org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.host.url=https://sonarcloud.io -Dsonar.organization=subhampanwarr-1 -Dsonar.projectKey=subhampanwarr-1_production-v3-java-login -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=300
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('application/java-login-app') {
                    sh 'docker buildx build --builder jenkins-v3-buildkit --platform linux/amd64 --progress=plain --load -t "$CI_IMAGE" .'
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker image inspect "$CI_IMAGE" >/dev/null
                    docker run --rm --entrypoint sh "$CI_IMAGE" -c 'test -s /usr/local/tomcat/webapps/ROOT.war && test "$(id -u)" = "10001"'
                    echo 'Docker image verification passed'
                '''
            }
        }

        stage('Trivy Vulnerability Scan') {
            steps {
                sh '''
                    set -eu
                    set +e
                    trivy image --scanners vuln --pkg-types library --severity HIGH,CRITICAL --timeout 15m --exit-code 1 --no-progress --format table --output trivy-report.txt "$CI_IMAGE"
                    trivy_status=$?
                    set -e

                    if [ -s trivy-report.txt ]; then
                        echo '=== Trivy Scan Results ==='
                        sed -n '1,100p' trivy-report.txt
                    fi
                    exit "$trivy_status"
                '''
            }
        }

        stage('Publish to ECR') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-publisher',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        AWS_REGION=us-east-1
                        REGISTRY="523881172609.dkr.ecr.${AWS_REGION}.amazonaws.com"

                        SHORT_SHA="$(git rev-parse --short=7 HEAD)"
                        IMAGE_TAG="ci-${BUILD_NUMBER}-${SHORT_SHA}"
                        ECR_IMAGE="${REGISTRY}/production-v3-java-login:${IMAGE_TAG}"

                        export DOCKER_CONFIG="$(mktemp -d)"
                        trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                        aws ecr get-login-password --region "$AWS_REGION" |
                            docker login --username AWS --password-stdin "$REGISTRY"
                        docker tag "$CI_IMAGE" "$ECR_IMAGE"
                        docker push "$ECR_IMAGE"

                        echo "$ECR_IMAGE" > ecr-image.txt
                        echo 'ECR image published successfully'
                        echo "$ECR_IMAGE"
                    '''
                }
                archiveArtifacts(artifacts: 'ecr-image.txt', fingerprint: true)
            }
        }

        stage('Approve EKS Deployment') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: 'Deploy this verified ECR image to the production-v3 EKS namespace?',
                          ok: 'Deploy to EKS'
                }
            }
        }

        stage('Deploy to EKS (Rolling Update + Rollback)') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-ecr-publisher',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        unset AWS_SESSION_TOKEN
                        export AWS_DEFAULT_REGION=us-east-1 AWS_PAGER=""

                        test -s ecr-image.txt
                        NEW_IMAGE="$(cat ecr-image.txt)"
                        if ! printf '%s\\n' "$NEW_IMAGE" | grep -Eq '^523881172609\\.dkr\\.ecr\\.us-east-1\\.amazonaws\\.com/production-v3-java-login:ci-[0-9]+-[0-9a-f]{7}$'; then
                            echo 'ERROR: Unexpected ECR image URI; refusing deployment'
                            exit 1
                        fi
                        echo "Requested image: $NEW_IMAGE"

                        ROLE_ARN="arn:aws:iam::523881172609:role/production-v3-jenkins-deploy-role"
                        ASSUMED="$(aws sts assume-role \
                            --role-arn "$ROLE_ARN" \
                            --role-session-name "jenkins-v3-deploy-${BUILD_NUMBER}" \
                            --duration-seconds 900 \
                            --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
                            --output text)"
                        set -- $ASSUMED
                        if [ "$#" -ne 3 ]; then
                            echo 'ERROR: Could not parse STS temporary credentials'
                            exit 1
                        fi
                        export AWS_ACCESS_KEY_ID="$1"
                        export AWS_SECRET_ACCESS_KEY="$2"
                        export AWS_SESSION_TOKEN="$3"
                        unset ASSUMED

                        KUBECONFIG="$(mktemp)"
                        export KUBECONFIG
                        trap 'rm -f "$KUBECONFIG"' EXIT
                        chmod 600 "$KUBECONFIG"
                        aws eks update-kubeconfig \
                            --name production-v3-eks \
                            --region us-east-1 \
                            --kubeconfig "$KUBECONFIG" >/dev/null

                        PREVIOUS_IMAGE="$(kubectl get deployment java-login-app \
                            -n production-v3 \
                            -o jsonpath='{.spec.template.spec.containers[?(@.name=="java-login-app")].image}')"
                        if [ -z "$PREVIOUS_IMAGE" ]; then
                            echo 'ERROR: Could not determine running application image'
                            exit 1
                        fi
                        echo "Previous image: $PREVIOUS_IMAGE"

                        if [ "$NEW_IMAGE" = "$PREVIOUS_IMAGE" ]; then
                            echo 'Deployment already uses this image; no update required.'
                            exit 0
                        fi

                        kubectl set image deployment/java-login-app \
                            "java-login-app=$NEW_IMAGE" -n production-v3

                        if ! kubectl rollout status deployment/java-login-app \
                            -n production-v3 --timeout=300s; then
                            echo 'ERROR: Rollout failed. Reverting to previous image.'
                            kubectl set image deployment/java-login-app \
                                "java-login-app=$PREVIOUS_IMAGE" -n production-v3
                            if ! kubectl rollout status deployment/java-login-app \
                                -n production-v3 --timeout=300s; then
                                echo 'CRITICAL: Rollback did not become healthy; manual intervention required.'
                            fi
                            exit 1
                        fi

                        ACTUAL_IMAGE="$(kubectl get deployment java-login-app \
                            -n production-v3 \
                            -o jsonpath='{.spec.template.spec.containers[?(@.name=="java-login-app")].image}')"
                        if [ "$ACTUAL_IMAGE" != "$NEW_IMAGE" ]; then
                            echo "ERROR: Expected image $NEW_IMAGE but found $ACTUAL_IMAGE"
                            kubectl set image deployment/java-login-app \
                                "java-login-app=$PREVIOUS_IMAGE" -n production-v3
                            kubectl rollout status deployment/java-login-app \
                                -n production-v3 --timeout=300s || true
                            exit 1
                        fi
                        echo "EKS rolling update succeeded: $ACTUAL_IMAGE"
                        kubectl get deployment java-login-app -n production-v3
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(artifacts: 'trivy-report.txt', allowEmptyArchive: true)
            archiveArtifacts(
                artifacts: 'application/java-login-app/target/*.war',
                allowEmptyArchive: true,
                fingerprint: true
            )
            sh 'docker image rm "$CI_IMAGE" >/dev/null 2>&1 || true'
        }
        success {
            echo 'Java CI and EKS CD completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review the console log; verify EKS rollout and rollback status if deployment was attempted.'
        }
    }
}
