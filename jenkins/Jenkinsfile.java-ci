pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    environment {
        CI_IMAGE = "java-login-app:ci-${BUILD_NUMBER}"
        DB_URL = 'jdbc:mysql://127.0.0.1:3306/UserDB'
        DB_USERNAME = 'ci_placeholder'
        DB_PASSWORD = 'ci_placeholder_only'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                    set -eu
                    java -version
                    mvn -version
                    docker version
                '''
            }
        }

        stage('Maven Build and Test') {
            steps {
                dir('application/java-login-app') {
                    sh 'mvn -B -ntp clean verify'
                }
            }
        }
        
        stage('SonarCloud Analysis') {
    steps {
        dir('application/java-login-app') {
            withCredentials([
                string(
                    credentialsId: 'sonarcloud-token',
                    variable: 'SONAR_TOKEN'
                )
            ]) {
                sh '''
                    set -eu
                    set +x

                    mvn -B -ntp \
                      org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                      -Dsonar.host.url=https://sonarcloud.io \
                      -Dsonar.organization=subhampanwarr-1 \
                      -Dsonar.projectKey=subhampanwarr-1_production-v3-java-login
                '''
            }
        }
    }
}        

        stage('Docker Build') {
            steps {
                dir('application/java-login-app') {
                    sh 'docker build -t "$CI_IMAGE" .'
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker image inspect "$CI_IMAGE" >/dev/null

                    docker run --rm \
                      --entrypoint sh \
                      "$CI_IMAGE" \
                      -c 'test -s /usr/local/tomcat/webapps/ROOT.war && test "$(id -u)" = "10001"'

                    echo "Docker image verification passed"
                '''
            }
        }

stage('Trivy Vulnerability Scan') {
    steps {
        sh '''
            set -eu

            trivy image \
              --scanners vuln \
              --severity HIGH,CRITICAL \
              --timeout 15m \
              --exit-code 0 \
              --no-progress \
              --format table \
              --output trivy-report.txt \
              "$CI_IMAGE"

            echo "=== Trivy Scan Results ==="
            sed -n '1,100p' trivy-report.txt
        '''
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'trivy-report.txt',
                allowEmptyArchive: true
            )
        }
    }
}
    }
    post {
        always {
            archiveArtifacts(
                artifacts: 'application/java-login-app/target/*.war',
                allowEmptyArchive: true,
                fingerprint: true
            )

            sh '''
                docker image rm "$CI_IMAGE" >/dev/null 2>&1 || true
            '''
        }

        success {
            echo 'Java application CI completed successfully.'
        }

        failure {
            echo 'Java application CI failed. Check the console log.'
        }
    }
}
